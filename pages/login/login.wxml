<view class="page login-page">
  <view class="login-shell">
    <view class="hero-card">
      <view class="hero-icon">豆</view>
      <view class="brand-badge">Bead Pattern</view>
      <view class="brand-title">豆豆图</view>
      <view class="brand-desc">把喜欢的图片变成可制作的拼豆图纸</view>
    </view>

    <view class="profile-card">
      <view class="card-title">设置你的资料</view>
      <view class="card-desc">可同步微信头像昵称，也可以手动修改</view>

      <button class="avatar-button" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar-placeholder">
          <view class="avatar-text">{{defaultAvatarText}}</view>
          <view class="avatar-hint">头像</view>
        </view>
      </button>

      <view class="nickname-field">
        <text class="field-label">昵称</text>
        <input
          class="nickname-input"
          type="nickname"
          placeholder="请输入昵称"
          value="{{nickname}}"
          bindinput="onNicknameInput"
          confirm-type="done"
        />
      </view>

      <button class="sync-button" bindtap="syncWechatProfile">一键同步微信资料</button>
    </view>

    <button class="primary-button login-button" loading="{{loggingIn}}" disabled="{{loggingIn}}" bindtap="login">
      {{loggingIn ? '登录中...' : '登录'}}
    </button>

    <view class="login-tip">登录后即可上传图片生成图纸；头像昵称仅用于展示，用户统计使用 openid。</view>
  </view>
</view>
