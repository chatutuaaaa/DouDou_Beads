.preview-page {
  display: flex;
  justify-content: center;
  padding: 28rpx 22rpx 42rpx;
}

.main-panel {
  box-sizing: border-box;
  width: 100%;
  max-width: 700rpx;
  min-height: calc(100vh - 56rpx);
  padding: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 54rpx;
  background: rgba(255, 255, 255, 0.48);
  box-shadow: 0 28rpx 86rpx rgba(94, 66, 42, 0.16);
  backdrop-filter: blur(26px);
  -webkit-backdrop-filter: blur(26px);
}

.section-card {
  box-sizing: border-box;
  margin-top: 22rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.68);
  box-shadow: 0 16rpx 42rpx rgba(96, 66, 42, 0.1);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.section-card:first-child {
  margin-top: 0;
}

.summary-card {
  color: #ffffff;
  background: linear-gradient(135deg, rgba(255, 138, 61, 0.94), rgba(244, 93, 72, 0.9));
}

.summary-head,
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.summary-kicker {
  font-size: 23rpx;
  font-weight: 900;
  opacity: 0.82;
}

.summary-title {
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.15;
}

.summary-badge {
  flex: none;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.2);
  font-size: 24rpx;
  font-weight: 900;
}

.summary-grid {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.summary-item {
  flex: 1;
  padding: 16rpx 8rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.18);
  text-align: center;
}

.summary-value {
  font-size: 30rpx;
  font-weight: 900;
}

.summary-label {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 22rpx;
}

.card-title {
  color: #2b2118;
  font-size: 30rpx;
  font-weight: 900;
}

.card-desc {
  margin-top: 8rpx;
  color: #8a7766;
  font-size: 23rpx;
}

.pattern-card {
  padding: 24rpx 20rpx 20rpx;
}

.grid-frame {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  margin-top: 22rpx;
  padding: 0;
  border: 4rpx solid rgba(48, 40, 32, 0.78);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.64);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.72), 0 16rpx 42rpx rgba(75, 51, 32, 0.1);
  overflow: hidden;
}

.pattern-board {
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow: hidden;
  border: 0;
  border-radius: 12rpx;
  background: #ffffff;
}

.pattern-row {
  display: flex;
  flex: 1;
  min-height: 0;
}

.pattern-cell {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 0;
  border-right: 1rpx solid rgba(0, 0, 0, 0.16);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.16);
  font-weight: 900;
  text-align: center;
}

.pattern-row:nth-child(29n) .pattern-cell {
  border-bottom-color: rgba(47, 42, 36, 0.74);
}

.pattern-cell:nth-child(29n) {
  border-right-color: rgba(47, 42, 36, 0.74);
}

.pattern-cell.dimmed {
  opacity: 0.16;
}

.mode-buttons {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.mode-button {
  flex: 1;
  margin: 0;
  border: 3rpx solid rgba(48, 40, 32, 0.72);
  border-radius: 18rpx;
  color: #49382a;
  background: rgba(255, 255, 255, 0.66);
  font-size: 23rpx;
  font-weight: 900;
}

.mode-button.active {
  border-color: #f45d48;
  color: #ffffff;
  background: linear-gradient(135deg, #ff8a3d, #f45d48);
  box-shadow: 0 12rpx 26rpx rgba(244, 93, 72, 0.22);
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.export-button,
.copy-button {
  flex: 1;
  height: 88rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}

.export-button {
  border: 4rpx solid rgba(48, 40, 32, 0.88);
  border-radius: 24rpx;
}

.copy-button {
  margin: 0;
  border: 3rpx solid rgba(48, 40, 32, 0.72);
  border-radius: 24rpx;
  color: #7a4d2f;
  background: rgba(255, 255, 255, 0.66);
  font-weight: 900;
}

.filter-tip {
  margin-top: 18rpx;
  color: #8a7766;
  font-size: 24rpx;
}

.clear-filter {
  margin-left: 16rpx;
  color: #e9653c;
  font-weight: 900;
}
